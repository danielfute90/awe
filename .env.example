# =====================================================================
# Awé — variables d'environnement
# Copie ce fichier en ".env" puis remplis les valeurs DANS .env.
# Ne partage JAMAIS ton fichier .env (il contient tes secrets).
# =====================================================================

# --- Mode démo --------------------------------------------------------
# true = démo sans aucune clé : faux Claude, fausse boîte Gmail, données d'exemple.
# Parfait pour essayer le projet. Les clés ci-dessous sont alors ignorées.
DEMO=false

# --- Général ----------------------------------------------------------
# development en local, production sur le serveur
NODE_ENV=development
PORT=3000
# Adresse publique du serveur (sert pour les liens web, OAuth Google et le webhook)
PUBLIC_URL=http://localhost:3000
# Fuseau horaire par défaut des nouveaux utilisateurs
FUSEAU_DEFAUT=Europe/Paris
# Niveau de détail des logs : debug, info, warn, error
LOG_LEVEL=info

# --- Base de données --------------------------------------------------
# En local : un fichier SQLite. En production : l'URL Postgres (postgres://...)
DATABASE_URL=file:./data/djo.db
# Dossier des PDF créés par Awé (un sous-dossier par utilisateur)
# STORAGE_DIR=storage

# --- Claude / Anthropic : le cerveau (phase 2) -------------------------
# Ta clé API sur console.anthropic.com (commence par sk-ant-)
ANTHROPIC_API_KEY=
# Modèle principal, et modèle rapide/économique pour les résumés
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Profondeur de réflexion : low, medium ou high
ANTHROPIC_EFFORT=medium
# Budget de tokens par utilisateur et par jour (l'admin n'est jamais bloqué : il reçoit une alerte à 80 %)
DAILY_TOKEN_LIMIT=200000
# Prix du modèle principal en dollars par million de tokens (pour estimer les coûts)
PRIX_ENTREE_1M=4
PRIX_SORTIE_1M=20

# --- ElevenLabs : la voix (phase 4) -----------------------------------
ELEVENLABS_API_KEY=
# Facultatif (valeurs par défaut économiques, adaptées au plan gratuit) :
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# Au-delà de ce nombre de caractères, Awé répond seulement par écrit
# VOIX_MAX_CARACTERES=600
# Notes vocales plus longues refusées (secondes)
# VOCAL_MAX_SECONDES=120

# --- Google / Gmail (phase 3) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Sécurité (phase 3) -----------------------------------------------
# 32 octets en hexadécimal (64 caractères). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Telegram (facultatif, plus tard) ---------------------------------
# Token donné par @BotFather. Vide = bot désactivé.
TELEGRAM_BOT_TOKEN=
# Ton ID Telegram (donné par @userinfobot) : relie ton compte admin à Telegram.
# Plusieurs comptes Telegram pour le même admin : sépare-les par une virgule (ex. 8111111111,5222222222)
ADMIN_TELEGRAM_ID=
# polling (simple, marche partout) ou webhook (nécessite une adresse HTTPS publique + le secret ci-dessous)
BOT_MODE=polling
# Secret vérifié sur chaque appel du webhook. Une longue chaîne aléatoire.
TELEGRAM_WEBHOOK_SECRET=
