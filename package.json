{
  "name": "awe",
  "version": "0.1.0",
  "private": true,
  "description": "Awé, assistant personnel IA sur Telegram et le web",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "chat": "tsx src/cli/chat.ts",
    "lien-web": "tsx src/cli/lien-web.ts",
    "web:install": "pnpm --dir web install",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@googleapis/gmail": "^22.1.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
